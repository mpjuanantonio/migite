    "test": "vitest run",
    "check:i18n": "vitest run src/i18n/check.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
